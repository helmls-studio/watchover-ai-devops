{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:watchover:schema:event:0.1",
  "title": "WatchOver event",
  "description": "One line of the append-only events.jsonl. Type-specific fields are enforced by the named check event-type-fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "at", "actor", "session_id", "type", "summary"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "id": { "$ref": "#/$defs/eventId" },
    "at": { "type": "string", "format": "date-time", "maxLength": 35 },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "name"],
      "properties": {
        "role": { "enum": ["ai", "human", "tool"] },
        "name": { "$ref": "#/$defs/id" }
      }
    },
    "session_id": { "$ref": "#/$defs/id" },
    "type": { "enum": ["stage_change", "intent", "result", "decision_request", "decision", "fact_verified", "plan_failure"] },
    "summary": { "$ref": "#/$defs/text" },
    "target": { "$ref": "#/$defs/short" },
    "action": { "type": "string", "minLength": 1, "maxLength": 1000, "description": "Sanitized command or action. Never raw output." },
    "action_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "enum": ["remote_mutating", "gated", "long_running", "read_only", "local"] }
    },
    "outcome": { "enum": ["succeeded", "failed", "partial", "unknown"] },
    "state_change": { "$ref": "#/$defs/text" },
    "evidence": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "pattern": "^evidence/(?!.*\\.\\.)[A-Za-z0-9._/-]+$", "maxLength": 200 }
    },
    "related": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/eventId" } },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": ["string", "null"], "enum": ["recon", "plan", "awaiting_decision", "executing", "verifying", "handoff", "incident", "recovered", "teardown", "closed", null] },
        "to": { "$ref": "#/$defs/stage" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "categories"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "categories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "enum": ["plan_acceptance", "billable", "dns", "delete", "destructive", "external_release"] }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "reply", "redacted", "outcome"],
      "properties": {
        "request_id": { "$ref": "#/$defs/id" },
        "reply": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "The human's reply as typed, except mandatory secret-value redaction." },
        "redacted": { "type": "boolean" },
        "outcome": { "enum": ["approved", "rejected", "changed", "deferred"] }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "status"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 120 },
        "status": { "$ref": "#/$defs/status" }
      }
    }
  },
  "$defs": {
    "status": { "enum": ["ASSUMED", "USER_CONFIRMED", "VERIFIED_LOCAL", "VERIFIED_REMOTE", "STALE", "UNKNOWN", "BLOCKED"] },
    "stage": { "enum": ["recon", "plan", "awaiting_decision", "executing", "verifying", "handoff", "incident", "recovered", "teardown", "closed"] },
    "eventId": { "type": "string", "pattern": "^evt-[0-9]{4,}$", "maxLength": 16 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 80 },
    "short": { "type": "string", "minLength": 1, "maxLength": 200 },
    "text": { "type": "string", "minLength": 1, "maxLength": 600 }
  }
}
