  "brief": {
    "app_summary": "demo-app: a small web app with a web front end, an HTTP API and a PostgreSQL database, packaged as a Docker Compose project.",
    "components": [
      {
        "name": "web",
        "role": "Serves the front end and forwards /api requests to the api service"
      },
      {
        "name": "api",
        "role": "HTTP API that reads and writes items in the database"
      },
      {
        "name": "db",
        "role": "PostgreSQL 16 with one data volume"
      }
    ],
    "topology": "One VM runs all three containers with Docker Compose. Only the web container is exposed, on port 80; api and db stay internal.",
    "resource_rationale": "Three small containers with low expected traffic fit on one small VM. A single VM keeps cost and moving parts low and is easy to tear down.",
    "heavier_alternatives": [
      {
        "alternative": "Managed Kubernetes cluster",
        "why_unnecessary": "Three containers on one host need no scheduler or node pool."
      },
      {
        "alternative": "Managed database service",
        "why_unnecessary": "The data set is small and a trial run does not need managed backups; tier C is offered if wanted."
      },
      {
        "alternative": "Load balancer",
        "why_unnecessary": "One VM serves the expected traffic directly."
      }
    ],
    "assumptions": [
      "Expected traffic is under 50 requests per minute (not confirmed by the operator)",
      "No public DNS name is needed for this run"
    ]
  },
